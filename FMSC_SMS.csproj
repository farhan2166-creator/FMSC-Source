<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <FmscToolsDirectory Condition="'$(FmscToolsDirectory)' == ''">$(MSBuildProjectDirectory)/../Tools</FmscToolsDirectory>
        <BundledGitDirectory Condition="'$(BundledGitDirectory)' == ''">$(FmscToolsDirectory)/MinGit</BundledGitDirectory>
        <BundledSqlCmdPath Condition="'$(BundledSqlCmdPath)' == ''">$(FmscToolsDirectory)/sqlcmd.exe</BundledSqlCmdPath>
        <LocalDbMsiPath Condition="'$(LocalDbMsiPath)' == ''">$(FmscToolsDirectory)/SqlLocalDB.msi</LocalDbMsiPath>
        <VcRedistPath Condition="'$(VcRedistPath)' == ''">$(FmscToolsDirectory)/vc_redist.x64.exe</VcRedistPath>
    </PropertyGroup>
    <Target Name="PrepareMaintenanceInputs" BeforeTargets="PrepareForPublish"
            Condition="'$(FmscSyntheticPublishFixture)' != 'true'">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/Tools/PrepareMaintenanceTools.ps1&quot; -ToolsDirectory &quot;$(FmscToolsDirectory)&quot; -GitDirectory &quot;$(BundledGitDirectory)&quot; -SqlCmdPath &quot;$(BundledSqlCmdPath)&quot; -LocalDbMsiPath &quot;$(LocalDbMsiPath)&quot; -VcRedistPath &quot;$(VcRedistPath)&quot;"
              EnvironmentVariables="PSModulePath=$(SystemRoot)\System32\WindowsPowerShell\v1.0\Modules" />
        <ItemGroup>
            <_MaintenanceGitFile Include="$(BundledGitDirectory)/**/*" />
            <_MaintenanceSqlCmdFile Include="$([System.IO.Path]::GetDirectoryName('$(BundledSqlCmdPath)'))/SqlCmd/**/*" />
            <_MaintenanceLocalDbFile Include="$([System.IO.Path]::GetDirectoryName('$(LocalDbMsiPath)'))/LocalDb/**/*" />
            <_MaintenanceVcRedistFile Include="$([System.IO.Path]::GetDirectoryName('$(VcRedistPath)'))/VcRedist/**/*" />
            <!-- Build may already have assigned content paths. Add the freshly
                 prepared bundles with explicit publish paths. -->
            <ContentWithTargetPath Include="@(_MaintenanceGitFile)" CopyToPublishDirectory="Always">
                <TargetPath>UpdateTransport/%(_MaintenanceGitFile.RecursiveDir)%(_MaintenanceGitFile.Filename)%(_MaintenanceGitFile.Extension)</TargetPath>
            </ContentWithTargetPath>
            <ContentWithTargetPath Include="@(_MaintenanceSqlCmdFile)" CopyToPublishDirectory="Always">
                <TargetPath>UpdateSupport/Tools/SqlCmd/%(_MaintenanceSqlCmdFile.RecursiveDir)%(_MaintenanceSqlCmdFile.Filename)%(_MaintenanceSqlCmdFile.Extension)</TargetPath>
            </ContentWithTargetPath>
            <ContentWithTargetPath Include="@(_MaintenanceLocalDbFile)" CopyToPublishDirectory="Always">
                <TargetPath>UpdateSupport/Tools/LocalDb/%(_MaintenanceLocalDbFile.RecursiveDir)%(_MaintenanceLocalDbFile.Filename)%(_MaintenanceLocalDbFile.Extension)</TargetPath>
            </ContentWithTargetPath>
            <ContentWithTargetPath Include="@(_MaintenanceVcRedistFile)" CopyToPublishDirectory="Always">
                <TargetPath>UpdateSupport/Tools/VcRedist/%(_MaintenanceVcRedistFile.RecursiveDir)%(_MaintenanceVcRedistFile.Filename)%(_MaintenanceVcRedistFile.Extension)</TargetPath>
            </ContentWithTargetPath>
        </ItemGroup>
    </Target>
    <ItemGroup>
        <Content Include="Installer/MaintenanceTools.ps1;Installer/ToolCatalog.json" Link="UpdateSupport/%(Filename)%(Extension)" CopyToPublishDirectory="Always" />
    </ItemGroup>
    <ItemGroup Condition="'$(FmscSyntheticPublishFixture)' == 'true'">
            <Content Include="$([System.IO.Path]::GetDirectoryName('$(BundledSqlCmdPath)'))/SqlCmd/**/*"
                     Link="UpdateSupport/Tools/SqlCmd/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="Always" />
            <Content Include="$([System.IO.Path]::GetDirectoryName('$(LocalDbMsiPath)'))/LocalDb/**/*"
                     Link="UpdateSupport/Tools/LocalDb/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="Always" />
            <Content Include="$([System.IO.Path]::GetDirectoryName('$(VcRedistPath)'))/VcRedist/**/*"
                     Link="UpdateSupport/Tools/VcRedist/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="Always" />
    </ItemGroup>
    <!-- The complete installer AND every update must carry Git/SSH and their
         supporting DLLs. Local compilation is unaffected; publish fails closed. -->
    <ItemGroup Condition="'$(FmscSyntheticPublishFixture)' == 'true'">
        <Content Include="$(BundledGitDirectory)\**\*"
                 Link="UpdateTransport\%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToPublishDirectory="Always" />
    </ItemGroup>
    <!-- Both full installs and application-only private updates keep the
         offline SQL dependency tools needed by later recovery/repair. -->
    <Target Name="RequireOfflineSqlToolsForPublish" BeforeTargets="PrepareForPublish"
            Condition="'$(FmscLevel2)' != 'true'">
        <Error Condition="'$(BundledSqlCmdPath)' == '' Or !Exists('$(BundledSqlCmdPath)')"
               Text="FMSC publishing requires verified go-sqlcmd. Supply BundledSqlCmdPath." />
        <Error Condition="'$(LocalDbMsiPath)' == '' Or !Exists('$(LocalDbMsiPath)')"
               Text="FMSC publishing requires the Microsoft-signed LocalDB MSI. Supply LocalDbMsiPath." />
        <Error Condition="'$(VcRedistPath)' == '' Or !Exists('$(VcRedistPath)')"
               Text="FMSC publishing requires the Microsoft-signed VC++ v14 x64 runtime. Supply VcRedistPath." />
    </Target>
    <Target Name="RequireBundledGitForPublish" BeforeTargets="PrepareForPublish"
            Condition="'$(FmscLevel2)' != 'true'">
        <Error Condition="'$(BundledGitDirectory)' == ''"
               Text="FMSC publishing requires pinned MinGit. Run Tools/PrepareBundledGit.ps1 and set BundledGitDirectory." />
        <Error Condition="!Exists('$(BundledGitDirectory)\cmd\git.exe')"
               Text="Bundled update transport is incomplete: cmd/git.exe missing." />
        <Error Condition="!Exists('$(BundledGitDirectory)\usr\bin\ssh.exe')"
               Text="Bundled update transport is incomplete: usr/bin/ssh.exe missing." />
        <Error Condition="!Exists('$(BundledGitDirectory)\COPYING-GIT.txt')"
               Text="Bundled Git GPLv2 license file is missing." />
        <Error Condition="!Exists('$(BundledGitDirectory)\THIRD_PARTY_NOTICES.txt')"
               Text="Bundled update transport notices are missing." />
    </Target>
    <!-- Schools receive this small GUI binary; no compiler is installed there. -->
    <Target Name="BuildStableUpdateLauncher" BeforeTargets="PrepareForBuild"
            Inputs="$(MSBuildProjectDirectory)/Installer/Launch-FMSC.cs"
            Outputs="$(BaseIntermediateOutputPath)FmscLauncher/$(Configuration)/FMSC.Launcher.exe">
        <MakeDir Directories="$(BaseIntermediateOutputPath)FmscLauncher/$(Configuration)" />
        <Exec Command="&quot;$(windir)\Microsoft.NET\Framework64\v4.0.30319\csc.exe&quot; /nologo /target:winexe /optimize+ /out:&quot;$(BaseIntermediateOutputPath)FmscLauncher\$(Configuration)\FMSC.Launcher.exe&quot; &quot;$(MSBuildProjectDirectory)\Installer\Launch-FMSC.cs&quot;" />
    </Target>
    <!-- Native Windows GUI launcher; backend/core.ps1 stays the safety authority. -->
    <Target Name="BuildFmscSetupLauncher" BeforeTargets="PrepareForBuild"
            Inputs="$(MSBuildProjectDirectory)/Installer/FMSC.Setup.cs"
            Outputs="$(BaseIntermediateOutputPath)FmscSetup/$(Configuration)/FMSC.Setup.exe">
        <MakeDir Directories="$(BaseIntermediateOutputPath)FmscSetup/$(Configuration)" />
        <Exec Command="&quot;$(windir)\Microsoft.NET\Framework64\v4.0.30319\csc.exe&quot; /nologo /target:winexe /optimize+ /win32icon:&quot;$(MSBuildProjectDirectory)\Assets\FMSC_Logo_Circular.ico&quot; /out:&quot;$(BaseIntermediateOutputPath)FmscSetup\$(Configuration)\FMSC.Setup.exe&quot; &quot;$(MSBuildProjectDirectory)\Installer\FMSC.Setup.cs&quot;" />
    </Target>
    <!-- Standalone WinForms uninstall launcher; the engine stages outside the app. -->
    <Target Name="BuildFmscUninstallLauncher" BeforeTargets="PrepareForBuild"
            Inputs="$(MSBuildProjectDirectory)/Installer/FMSC.Uninstall.cs"
            Outputs="$(BaseIntermediateOutputPath)FmscUninstall/$(Configuration)/FMSC.Uninstall.exe">
        <MakeDir Directories="$(BaseIntermediateOutputPath)FmscUninstall/$(Configuration)" />
        <Exec Command="&quot;$(windir)\Microsoft.NET\Framework64\v4.0.30319\csc.exe&quot; /nologo /target:winexe /optimize+ /win32icon:&quot;$(MSBuildProjectDirectory)\Assets\FMSC_Logo_Circular.ico&quot; /out:&quot;$(BaseIntermediateOutputPath)FmscUninstall\$(Configuration)\FMSC.Uninstall.exe&quot; &quot;$(MSBuildProjectDirectory)\Installer\FMSC.Uninstall.cs&quot;" />
    </Target>
    <!-- Opt-in test binary; normal builds contain no disposable-target override. -->
    <PropertyGroup Condition="'$(FmscLevel2)' == 'true'">
        <DefineConstants>$(DefineConstants);FMSC_LEVEL2</DefineConstants>
        <OutputPath>bin\Level2\$(Configuration)\</OutputPath>
    </PropertyGroup>
    <Target Name="RejectLevel2Publish" BeforeTargets="PrepareForPublish" Condition="'$(FmscLevel2)' == 'true'">
        <Error Text="The isolated Level 2 test binary must never be published as a school application." />
    </Target>
    <ItemGroup>
        <!-- Portable shortcut checks build separately with simulated controls. -->
        <Compile Remove="Tests/**/*.cs" />
        <Compile Remove="Apps/**/*.cs" />
        <!-- Standalone update packaging CLI is not part of the WinForms executable. -->
        <Compile Remove="Tools/**/*.cs" />
        <Compile Remove="Installer/Launch-FMSC.cs" />
        <Compile Remove="Installer/FMSC.Setup.cs" />
        <Compile Remove="Installer/FMSC.Uninstall.cs" />
    </ItemGroup>
	<PropertyGroup>
		<!-- Local verification repositories and generated files are not application inputs. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**</DefaultItemExcludes>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWindowsForms>true</UseWindowsForms>
		<!-- Keep English and Urdu library translations; neutral English resources remain embedded. -->
		<SatelliteResourceLanguages>en;en-US;en-GB;ur;ur-PK;ur-IN</SatelliteResourceLanguages>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<ApplicationIcon>Assets\FMSC_Logo_Circular.ico</ApplicationIcon>
		<!-- The installer version is the only editable application version; keep assembly/file metadata in sync. -->
		<!-- Read the same exact source used by installer schema validation. -->
		<_FmscInstallerText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Installer/core.ps1'))</_FmscInstallerText>
		<Version>$([System.Text.RegularExpressions.Regex]::Match('$(_FmscInstallerText)', '[$]AppVersion = [^0-9]*([0-9]+[.][0-9]+[.][0-9]+(?:-[A-Za-z0-9-]+(?:[.][A-Za-z0-9-]+)*)?)').Groups[1].Value)</Version>
		<AssemblyVersion>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^[0-9]+[.][0-9]+[.][0-9]+').Value).0</AssemblyVersion>
		<FileVersion>$(AssemblyVersion)</FileVersion>
	</PropertyGroup>
	<ItemGroup>
        <!-- Public IDs and optional publisher-supplied native Google registration; no school tokens. -->
        <Content Include="CloudBackupGoogleDesktop.json" Condition="Exists('CloudBackupGoogleDesktop.json')"
                 CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
        <Content Include="CloudBackupProviders.json" CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
		<Content Include="Installer/core.ps1" Link="UpdateSupport/core.ps1" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="Installer/UpdateRecovery.ps1" Link="UpdateSupport/UpdateRecovery.ps1" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="Installer/Launch-FMSC.ps1" Link="UpdateSupport/Launch-FMSC.ps1" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="$(BaseIntermediateOutputPath)FmscLauncher/$(Configuration)/FMSC.Launcher.exe" Link="UpdateSupport/FMSC.Launcher.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="$(BaseIntermediateOutputPath)FmscSetup/$(Configuration)/FMSC.Setup.exe" Link="UpdateSupport/FMSC.Setup.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="$(BaseIntermediateOutputPath)FmscUninstall/$(Configuration)/FMSC.Uninstall.exe" Link="FMSC.Uninstall.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="Installer/Uninstall-FMSC.ps1" Link="UpdateSupport/Uninstall-FMSC.ps1" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="Migrations/*.sql" Link="UpdateSupport/Migrations/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="Assets\academics.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Assets\administration.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Assets\dashboard.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Assets\finance.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Assets\FMSC_Logo_Circular.ico" CopyToOutputDirectory="PreserveNewest" />
		<!-- The setup/update header renders this PNG directly; do not rely on ICO conversion. -->
		<Content Include="Assets\FMSC_Logo_Circular.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="Assets\FMSC_Logo_Rectangular.png" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Assets\header.png" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Assets\promotion.png">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Assets\reports.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Assets\setup.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Assets\staff.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Assets\students.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Pages\Reports\Templates\*.rdlc">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>Reports\%(Filename)%(Extension)</Link>
			<Visible>false</Visible>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<None Remove="Assets\academics.png" />
		<None Remove="Assets\administration.png" />
		<None Remove="Assets\dashboard.png" />
		<None Remove="Assets\finance.png" />
		<None Remove="Assets\promotion.png" />
		<None Remove="Assets\reports.png" />
		<None Remove="Assets\setup.png" />
		<None Remove="Assets\staff.png" />
		<None Remove="Assets\students.png" />
	</ItemGroup>
	<ItemGroup>
		<!-- Include every current/future schema contract; no fixed schema-specific list. -->
		<EmbeddedResource Include="Core\DatabaseCompatibility*Requirements.json" />
		<EmbeddedResource Include="Core\PermissionCatalog.json" LogicalName="FMSC_SMS.Core.PermissionCatalog.json" />
		<EmbeddedResource Include="Pages\Students\Admissions\PlacementCorrection.sql" />
		<EmbeddedResource Include="Pages\Students\Admissions\MissingPlacementWindows.sql" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
		<PackageReference Include="PdfPig" Version="0.1.16" />
		<PackageReference Include="PDFsharp-MigraDoc-GDI" Version="6.2.4" />
		<PackageReference Include="ReportViewerCore.WinForms" Version="15.1.33" />
		<PackageReference Include="ClosedXML" Version="0.105.1" />
	</ItemGroup>
	<ItemGroup>
		<None Update="Installer\core.ps1">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Update="Installer\Install FMSC_SMS.bat">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<!-- Established user decision (see AGENTS.md): the user places the latest detached MDF/LDF
	     in ../Database when preparing a release package. Their absence during development
	     is expected and must not be reported as a release-readiness blocker.
	     Database snapshots are optional for app-only updates. When supplied in the adjacent
	     Database folder (or DeploymentDatabaseDirectory), validate and copy both detached files.
	     Fresh installations still require a compatible snapshot; existing live data is preserved. -->
	<!-- Only the private GitHub Actions application-only ZIP may skip installer
	     prerequisites/copying. Normal full release publishing remains validated. -->
	<!-- Validate installer, prerequisite, migrations and any supplied database snapshot before publishing. -->
    <Target Name="ValidateGoogleDesktopPublishInput" BeforeTargets="PrepareForPublish"
            Condition="'$(RequireGoogleDesktopRegistration)' == 'true' And '$(FmscSyntheticPublishFixture)' != 'true'">
        <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Tools\ValidateGoogleDesktopPublish.ps1&quot; -ApplicationDirectory &quot;$(MSBuildProjectDirectory)&quot;"
              EnvironmentVariables="PSModulePath=$(SystemRoot)\System32\WindowsPowerShell\v1.0\Modules" />
    </Target>
    <Target Name="ValidateGoogleDesktopPublishOutput" AfterTargets="Publish"
            Condition="'$(RequireGoogleDesktopRegistration)' == 'true' And '$(FmscSyntheticPublishFixture)' != 'true'">
        <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Tools\ValidateGoogleDesktopPublish.ps1&quot; -ApplicationDirectory &quot;$(PublishDir)\.&quot;"
              EnvironmentVariables="PSModulePath=$(SystemRoot)\System32\WindowsPowerShell\v1.0\Modules" />
    </Target>
	<Target Name="ValidateDeploymentAssets" BeforeTargets="PrepareForPublish" Condition="'$(CIAppOnlyBundle)' != 'true' Or '$(GITHUB_ACTIONS)' != 'true'">
		<PropertyGroup>
			<DeploymentDatabaseDirectory Condition="'$(DeploymentDatabaseDirectory)' == ''">$(MSBuildProjectDirectory)\..\Database</DeploymentDatabaseDirectory>
			<DeploymentMigrationDirectory Condition="'$(DeploymentMigrationDirectory)' == ''">$(MSBuildProjectDirectory)\Migrations</DeploymentMigrationDirectory>
			<_InstallerScript>$(MSBuildProjectDirectory)\Installer\core.ps1</_InstallerScript>
			<_InstallerText>$([System.IO.File]::ReadAllText('$(_InstallerScript)'))</_InstallerText>
			<!-- [$] escapes the PowerShell variable marker from MSBuild property expansion. -->
			<_RequiredSchemaVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_InstallerText)', '[$]DatabaseVersion = [^0-9]*([0-9]+)').Groups[1].Value)</_RequiredSchemaVersion>
		</PropertyGroup>
		<Error Condition="'$(_RequiredSchemaVersion)' == ''" Text="Could not read the required schema version from Installer\core.ps1. Expected a line like: `$DatabaseVersion = '6'" />
		<ItemGroup>
			<_RequiredDeploymentFile Include="$(MSBuildProjectDirectory)\Installer\core.ps1" />
			<_RequiredDeploymentFile Include="$(MSBuildProjectDirectory)\Installer\Install FMSC_SMS.bat" />
		</ItemGroup>
		<Error Condition="'@(_RequiredDeploymentFile)' != '' AND !Exists('%(FullPath)')" Text="Required release asset is missing: %(FullPath). Publishing has been stopped." />
		<!-- Both SQL tools are bundled; .NET is included in the self-contained app. -->
		<Error Condition="!Exists('$(LocalDbMsiPath)')" Text="Required LocalDB prerequisite is missing: $(LocalDbMsiPath). Supply LocalDbMsiPath or place SqlLocalDB.msi in ..\Tools." />
        <Error Condition="!Exists('$(VcRedistPath)')" Text="Required Visual C++ runtime prerequisite is missing: $(VcRedistPath)." />
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Installer\ValidateReleaseAssets.ps1&quot; -DatabaseDirectory &quot;$(DeploymentDatabaseDirectory)&quot; -LocalDbMsiPath &quot;$(LocalDbMsiPath)&quot;"
              EnvironmentVariables="PSModulePath=$(SystemRoot)\System32\WindowsPowerShell\v1.0\Modules" />
	</Target>
	<Target Name="RemoveEmptyPublishLanguageFolders" AfterTargets="Publish" BeforeTargets="CopyDeploymentFiles">
		<!-- End the argument with a dot so a trailing backslash cannot escape its closing quote. -->
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Tools\RemoveEmptyPublishLanguageFolders.ps1&quot; -PublishDirectory &quot;$(PublishDir)\.&quot;"
              EnvironmentVariables="PSModulePath=$(SystemRoot)\System32\WindowsPowerShell\v1.0\Modules" />
	</Target>
	<Target Name="CopyDeploymentFiles" AfterTargets="Publish" DependsOnTargets="ValidateDeploymentAssets" Condition="'$(CIAppOnlyBundle)' != 'true' Or '$(GITHUB_ACTIONS)' != 'true'">
		<PropertyGroup>
			<ReleaseRoot Condition="'$(ReleaseRoot)' == ''">$(MSBuildProjectDirectory)\..\FMSC_SMS_Release\</ReleaseRoot>
		</PropertyGroup>
		<MakeDir Directories="$(ReleaseRoot)Database" Condition="Exists('$(DeploymentDatabaseDirectory)\FMSC_DB.mdf')" />
		<Copy SourceFiles="$(DeploymentDatabaseDirectory)\FMSC_DB.mdf" DestinationFiles="$(ReleaseRoot)Database\FMSC_DB.mdf" SkipUnchangedFiles="true" Condition="Exists('$(DeploymentDatabaseDirectory)\FMSC_DB.mdf')" />
		<Copy SourceFiles="$(DeploymentDatabaseDirectory)\FMSC_DB_log.ldf" DestinationFiles="$(ReleaseRoot)Database\FMSC_DB_log.ldf" SkipUnchangedFiles="true" Condition="Exists('$(DeploymentDatabaseDirectory)\FMSC_DB_log.ldf')" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)/Installer/MaintenanceTools.ps1;$(MSBuildProjectDirectory)/Installer/ToolCatalog.json" DestinationFolder="$(ReleaseRoot)" SkipUnchangedFiles="true" />
        <MakeDir Directories="$(ReleaseRoot)Tools" />
		<Copy SourceFiles="$(LocalDbMsiPath)" DestinationFiles="$(ReleaseRoot)Tools\SqlLocalDB.msi" SkipUnchangedFiles="true" />
        <Copy SourceFiles="$(VcRedistPath)" DestinationFiles="$(ReleaseRoot)Tools\vc_redist.x64.exe" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(BundledSqlCmdPath)" DestinationFiles="$(ReleaseRoot)Tools\sqlcmd.exe" SkipUnchangedFiles="true" />
		<MakeDir Directories="$(ReleaseRoot)Migrations" />
		<ItemGroup>
			<MigrationFiles Include="$(DeploymentMigrationDirectory)\*.sql" />
			<MigrationApplierFiles Include="$(MSBuildProjectDirectory)\Migrations\Apply-Migrations.ps1;$(MSBuildProjectDirectory)\Migrations\Apply-Migrations.bat;$(MSBuildProjectDirectory)\Migrations\README.md" />
			<RetiredReleaseMigrationFiles Include="$(ReleaseRoot)Migrations\*.sql" Exclude="@(MigrationFiles->'$(ReleaseRoot)Migrations\%(Filename)%(Extension)')" />
			<CurrentUpdateMigrationFiles Include="$(MSBuildProjectDirectory)\Migrations\*.sql" />
			<RetiredUpdateMigrationFiles Include="$(PublishDir)UpdateSupport\Migrations\*.sql" Exclude="@(CurrentUpdateMigrationFiles->'$(PublishDir)UpdateSupport\Migrations\%(Filename)%(Extension)')" />
		</ItemGroup>
		<!-- Reusing a local publish directory must not ship retired development SQL. -->
		<Delete Files="@(RetiredReleaseMigrationFiles);@(RetiredUpdateMigrationFiles)" />
		<Copy SourceFiles="@(MigrationFiles)" DestinationFiles="@(MigrationFiles->'$(ReleaseRoot)Migrations\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(MigrationApplierFiles)" DestinationFolder="$(ReleaseRoot)Migrations" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)\Installer\core.ps1" DestinationFiles="$(ReleaseRoot)core.ps1" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(BaseIntermediateOutputPath)FmscSetup/$(Configuration)/FMSC.Setup.exe" DestinationFiles="$(ReleaseRoot)FMSC.Setup.exe" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(BaseIntermediateOutputPath)FmscUninstall/$(Configuration)/FMSC.Uninstall.exe" DestinationFiles="$(ReleaseRoot)FMSC.Uninstall.exe" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)\Installer\Uninstall-FMSC.ps1" DestinationFiles="$(ReleaseRoot)Uninstall-FMSC.ps1" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)\Installer\UpdateRecovery.ps1" DestinationFiles="$(ReleaseRoot)UpdateRecovery.ps1" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)\Installer\Install FMSC_SMS.bat" DestinationFiles="$(ReleaseRoot)Install FMSC_SMS.bat" SkipUnchangedFiles="true" />
	</Target>
	<ItemGroup>
	  <EditorConfigFiles Remove=".editorconfig" />
	</ItemGroup>
	<ItemGroup>
	  <None Include=".editorconfig" />
	</ItemGroup>

  <Target Name="RemoveRetiredFeeReportTemplates" AfterTargets="CopyFilesToOutputDirectory;Publish">
    <Delete Files="$(TargetDir)Reports\AdmissionBill.rdlc;$(TargetDir)Reports\FeePaymentReceipt.rdlc;$(TargetDir)Reports\FeeReminder.rdlc;$(TargetDir)Reports\FeeAgingReport.rdlc" Condition="'$(TargetDir)' != ''" />
    <Delete Files="$(PublishDir)Reports\AdmissionBill.rdlc;$(PublishDir)Reports\FeePaymentReceipt.rdlc;$(PublishDir)Reports\FeeReminder.rdlc;$(PublishDir)Reports\FeeAgingReport.rdlc" Condition="'$(PublishDir)' != ''" />
  </Target>
</Project>
