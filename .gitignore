!/Tests/AuditFixChecks/*.cs
!/Tests/AuditFixChecks/*.csproj
/Tests/QuickRegistrationSqlChecks/*
!/Tests/QuickRegistrationSqlChecks/*.cs
!/Tests/QuickRegistrationSqlChecks/*.csproj
!/Tests/QuickRegistrationSqlChecks/Migration4Checks.sql
!/Tests/QuickRegistrationSqlChecks/Migration5Checks.sql
/Tests/PerformanceChecks/*
!/Tests/PerformanceChecks/*.cs
!/Tests/PerformanceChecks/*.csproj
/Tests/ThemeSmokeChecks/*
!/Tests/ThemeSmokeChecks/*.cs
!/Tests/ThemeSmokeChecks/*.csproj
/Tests/AdministrationSqlChecks/*
!/Tests/AdministrationSqlChecks/*.cs
!/Tests/AdministrationSqlChecks/*.csproj

!Tests/AdministrationSqlChecks/*.sql

!/Tests/MutationSqlChecks/
/Tests/MutationSqlChecks/*
!/Tests/MutationSqlChecks/*.cs
