# External communication regression sources only.
!/Tests/CommunicationChecks/
/Tests/CommunicationChecks/*
!/Tests/CommunicationChecks/*.cs
!/Tests/CommunicationChecks/*.csproj

# Offline help catalog checks (source only).
!/Tests/HelpChecks/
/Tests/HelpChecks/*
!/Tests/HelpChecks/*.cs
!/Tests/HelpChecks/*.csproj
# Level 3 keeps source/catalog only; private SQL and generated evidence stay outside it.
!/Tests/Level3Checks/
/Tests/Level3Checks/*
!/Tests/Level3Checks/*.cs
!/Tests/Level3Checks/*.py
!/Tests/Level3Checks/catalog.json
!/Tests/Level3Checks/*.ps1

# Versioned SQL scripts are test-only fixtures; never package them as upgrades.
!/Tests/LifecycleSqlChecks/Migrations/
/Tests/LifecycleSqlChecks/Migrations/*
!/Tests/LifecycleSqlChecks/Migrations/*.sql

# Focused read-only report regression sources; build outputs stay ignored.
!/Tests/ReportReadChecks/
/Tests/ReportReadChecks/*
!/Tests/ReportReadChecks/*.cs
!/Tests/ReportReadChecks/*.csproj
!/Tests/ReportRdlcChecks/
/Tests/ReportRdlcChecks/*
!/Tests/ReportRdlcChecks/*.cs
!/Tests/ReportRdlcChecks/*.csproj

# Isolated communication and restore safety regression sources.
!/Tests/AdmissionActionsChecks/
/Tests/AdmissionActionsChecks/*
!/Tests/AdmissionActionsChecks/*.cs
!/Tests/AdmissionActionsChecks/*.csproj

!/Tests/SafetySqlChecks/
/Tests/SafetySqlChecks/*
!/Tests/SafetySqlChecks/*.cs
!/Tests/SafetySqlChecks/*.csproj

# Portable contact and academic-year validation regression sources only.
!/Tests/ContactValidationChecks/
/Tests/ContactValidationChecks/*
!/Tests/ContactValidationChecks/*.cs
!/Tests/ContactValidationChecks/*.csproj
!/Tests/AcademicYearChecks/
/Tests/AcademicYearChecks/*
!/Tests/AcademicYearChecks/*.cs
!/Tests/AcademicYearChecks/*.csproj

# Global lookup contracts and disposable fixture source only.
!/Tests/GlobalSearchChecks/
/Tests/GlobalSearchChecks/*
!/Tests/GlobalSearchChecks/*.cs
!/Tests/GlobalSearchChecks/*.csproj

# Cloud backup regression sources; keep generated build outputs ignored.
!/Tests/CloudBackupCryptoChecks/
/Tests/CloudBackupCryptoChecks/*
!/Tests/CloudBackupCryptoChecks/*.cs
!/Tests/CloudBackupCryptoChecks/*.csproj

# Publisher's downloaded Google Desktop OAuth registration. Never commit credentials.
/CloudBackupGoogleDesktop.json
!/Tests/CloudBackupCoordinatorChecks/
/Tests/CloudBackupCoordinatorChecks/*
!/Tests/CloudBackupCoordinatorChecks/*.cs
!/Tests/CloudBackupCoordinatorChecks/*.csproj

# Production backup services are source, not generated backup directories.
!/Services/Backup/
!/Services/Backup/*.cs
!/Tests/SafetySqlChecks/run.py
