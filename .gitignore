# Level 1 sources and the reviewed schema-only fixture; never generated output or credentials.
!/Tests/LifecycleSqlChecks/
/Tests/LifecycleSqlChecks/*
!/Tests/LifecycleSqlChecks/*.cs
!/Tests/LifecycleSqlChecks/*.csproj
!/Tests/LifecycleSqlChecks/*.py
!/Tests/LifecycleSqlChecks/.config/
!/Tests/LifecycleSqlChecks/.config/dotnet-tools.json
!/Tests/LifecycleSqlChecks/Baseline/
/Tests/LifecycleSqlChecks/Baseline/*
!/Tests/LifecycleSqlChecks/Baseline/schema.dacpac
!/Tests/LifecycleSqlChecks/Baseline/provenance.json
!/Tests/LifecycleSqlChecks/Baseline/*.sql
!/Tests/LifecycleSqlChecks/Baseline/Sql/
